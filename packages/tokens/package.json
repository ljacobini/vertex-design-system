{
  "name": "@vertex/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Vertex design tokens: HSL CSS vars + brand colors + severity scale + dark mode + multi-tenant override",
  "type": "module",
  "main": "./dist/index.js",

{
  "name": "@vertex/auth-pattern",
  "version": "1.0.0",
  "private": true,
  "description": "Vertex shared auth + RBAC foundation: role/permission contract, Auth.js v5 config factory, JWT verify (jose), tenant+role React context. Consumed by SAAS/PB/PMI.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["src", "README.md"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.tsx",
      "import": "./src/react.tsx",
      "default": "./src/react.tsx"
    },
    "./roles": {
      "types": "./src/roles.ts",
      "import": "./src/roles.ts",
      "default": "./src/roles.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "jose": "^5.9.0"
  },
  "peerDependencies": {
    "next-auth": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next-auth": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "next-auth": "^5.0.0-beta.25",
    "typescript": "^5.5.0",
    "rimraf": "^6.0.1"
  }
}
